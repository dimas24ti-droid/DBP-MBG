<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_home">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Greeting Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Makanan Bergizi Gratis"
                        android:textColor="#005B96"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/logo_mbg"
                    android:contentDescription="Logo MBG"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <!-- Grid Statistik 2x2 -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="16dp">

                <!-- Card 1: Total Produksi -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:background="#0072BC"
                    android:padding="16dp"
                    android:layout_margin="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Produksi Hari Ini"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.250"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Porsi"
                        android:textColor="#E3F2FD"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card 2: Jumlah Penerima -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:background="#009688"
                    android:padding="16dp"
                    android:layout_margin="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jumlah Penerima"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.200"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anak"
                        android:textColor="#E0F2F1"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card 3: Stok Bahan -->
                <LinearLayout
                    android:id="@+id/btnStok"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:background="#005B96"
                    android:padding="16dp"
                    android:layout_margin="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stok Bahan"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jenis"
                        android:textColor="#E3F2FD"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card 4: Menu Hari Ini -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:background="#3F51B5"
                    android:padding="16dp"
                    android:layout_margin="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Menu Hari Ini"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nasi + Ayam"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Sayur + Buah"
                        android:textColor="#E8EAF6"
                        android:textSize="12sp" />
                </LinearLayout>

            </GridLayout>

            <!-- Tombol Pertemuan 10 -->
            <Button
                android:id="@+id/btnPertemuan10"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="PELAJARI PERTEMUAN 10 (TabLayout &amp; RecyclerView)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#673AB7"
                android:layout_marginBottom="16dp" />

            <!-- RecyclerView Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Log Aktivitas Dapur Terbaru"
                android:textColor="#005B96"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp" />

            <!-- Tombol Produksi dan Distribusi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnProduksi"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:text="Produksi"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#0072BC"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnDistribusi"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:text="Distribusi"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#005B96"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <!-- Tombol Profil Pendistribusian -->
            <Button
                android:id="@+id/btnDistribusiProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="PROFIL PENDISTRIBUSIAN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#00838F"
                android:layout_marginBottom="16dp" />

            <!-- Tombol Profil Developer -->
            <Button
                android:id="@+id/btnProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="PROFIL DEVELOPER"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#0072BC"
                android:layout_marginBottom="16dp" />

            <!-- Tombol Logout -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="LOGOUT"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#005B96"
                android:layout_marginBottom="16dp" />

            <!-- Website Resmi BGN -->
            <Button
                android:id="@+id/linkWebsite"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Kunjungi Website Resmi (www.bgn.go.id)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#003366"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
