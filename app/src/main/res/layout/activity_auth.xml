<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F3F8FC">

    <ImageView
        android:id="@+id/imgLogoAuth"
        android:layout_width="150dp"
        android:layout_height="120dp"
        android:src="@drawable/logo_mbg"
        android:contentDescription="Logo MBG"
        android:scaleType="fitCenter"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SISTEM INFORMASI MBG"
        android:textColor="#005B96"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Silakan login untuk melanjutkan"
        android:textColor="#526779"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="28dp" />

    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Username"
        android:inputType="text"
        android:singleLine="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:backgroundTint="#0072BC"
        android:layout_marginBottom="14dp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Password"
        android:inputType="textPassword"
        android:singleLine="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:backgroundTint="#0072BC"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="LOGIN"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#0072BC" />

</LinearLayout>