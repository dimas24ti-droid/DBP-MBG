<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0072BC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgLogoSplash"
            android:layout_width="180dp"
            android:layout_height="140dp"
            android:src="@drawable/logo_mbg"
            android:contentDescription="Logo MBG"
            android:scaleType="fitCenter"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DBP-MBG"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Makan Bergizi Gratis"
            android:textColor="#EAF6FF"
            android:textSize="17sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sistem Informasi Operasional Dapur"
            android:textColor="#EAF6FF"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</FrameLayout>