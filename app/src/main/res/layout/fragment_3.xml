<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo_mbg"
            android:contentDescription="Logo MBG"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚚 Distribusi &amp; Profil"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#005B96"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnOpenDistribusi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buka Halaman Distribusi"
            android:backgroundTint="#0072BC"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnOpenDistribusiProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buka Profil Pendistribusian"
            android:backgroundTint="#00838F"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
