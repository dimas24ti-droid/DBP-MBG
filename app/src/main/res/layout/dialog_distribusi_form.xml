<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tambah Distribusi Makanan"
        android:textColor="#005B96"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etNamaLokasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nama Lokasi / Sekolah (e.g. SDN 01 Pagi)"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etJumlahPorsi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Jumlah Porsi (e.g. 300)"
        android:inputType="number"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etPenerima"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Target Penerima (e.g. Siswa Kelas 1-6)"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Status (e.g. Menunggu, Dalam Pengiriman, Selesai)"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etTanggal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tanggal (e.g. 2026-11-23)"
        android:inputType="date"
        android:layout_marginBottom="16dp" />

</LinearLayout>